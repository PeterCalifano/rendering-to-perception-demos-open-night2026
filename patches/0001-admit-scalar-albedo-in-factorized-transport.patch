+TEST_CASE("Single-channel albedo textures scale factorized Lambertian and Lommel-Seeliger transport",
+          "[core][render][factorized][texture]")
+{
+    if (!HasGpu()) SKIP("A CUDA device is required for transport tests.");
+    image_io::SImageData texture;
+    texture.width = texture.height = 1U;
+    texture.channels = 1U;
+    texture.scalarType = image_io::EImageScalarType::UINT8;
+    texture.rowStrideBytes = 1U;
+    texture.storage = {128U};
+
+    for (const bool lommel : {false, true})
+    {
+        const SMaterialDescriptor::TModel model = lommel
+            ? SMaterialDescriptor::TModel(SLommelSeeligerParams{Vec3Type(0.5f)})
+            : SMaterialDescriptor::TModel(SLambertianParams{Vec3Type(0.5f)});
+        for (const bool measurement : {false, true})
+        {
+            CAPTURE(lommel, measurement);
+            STransportFixture plain(SMaterialDescriptor{model, -1});
+            STransportFixture mapped(SMaterialDescriptor{model, 0}, &texture);
+            for (STransportFixture *fixture : {&plain, &mapped})
+            {
+                fixture->params.renderSettings.radiometryMode = ERadiometryMode::FACTORIZED_SPECTRAL;
+                if (measurement)
+                {
+                    fixture->enableMeasurement();
+                    fixture->params.renderSettings.factorizedSensorWavebands = EFactorizedSensorWavebands::RGB;
+                    fixture->params.factorizedMeasurement.wavebandCount = 3U;
+                    fixture->params.factorizedMeasurement.wavebandScale[0] = 2.0f;
+                    fixture->params.factorizedMeasurement.wavebandScale[1] = 3.0f;
+                    fixture->params.factorizedMeasurement.wavebandScale[2] = 5.0f;
+                }
+                fixture->install();
+            }
+            const auto reference = plain.renderer.render();
+            const auto textured = mapped.renderer.render();
+            const std::size_t activeBands = measurement ? 3U : 1U;
+            for (std::size_t band = 0; band < activeBands; ++band)
+            {
+                REQUIRE(reference[band] > 0.0f);
+                CHECK(textured[band] ==
+                      Catch::Approx(reference[band] * 128.0f / 255.0f).epsilon(5e-5));
+            }
+        }
+    }
+
+    STransportFixture chromatic(
+        SMaterialDescriptor{SLambertianParams{Vec3Type(0.25f, 0.5f, 0.75f)}, 0}, &texture);
+    chromatic.params.renderSettings.radiometryMode = ERadiometryMode::FACTORIZED_SPECTRAL;
+    chromatic.renderer.setLaunchParams(chromatic.params);
+    REQUIRE_THROWS_WITH(chromatic.renderer.buildPipelineAndSBT(),
+                        Catch::Matchers::ContainsSubstring("achromatic material"));
+}
